<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" package="org.adi.scopy" android:installLocation="auto" android:versionCode="-- %%INSERT_VERSION_CODE%% --" android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- %%INSERT_FEATURES -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <supports-screens android:anyDensity="true" android:largeScreens="true" android:normalScreens="true" android:smallScreens="true"/>

    <application android:name="org.adi.scopy.ScopyApplication" android:extractNativeLibs="true" android:hardwareAccelerated="true" android:label="Scopy" android:icon="@drawable/icon">
	<receiver android:name="libusb.android.USB_PERMISSION" android:exported="false"/>
	<activity android:name="org.adi.scopy.ScopyActivity"
		  android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
		  android:label="Scopy"
		  android:launchMode="singleTop"
		  android:theme="@style/splashScreenTheme"
		  android:screenOrientation="userLandscape"
		  android:exported="true"
		  tools:ignore="LockedOrientationActivity">
	    <intent-filter>
		<action android:name="libusb.android.USB_PERMISSION"/>
		<action android:name="android.intent.action.MAIN"/>
		<category android:name="android.intent.category.LAUNCHER"/>
		<action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
	    </intent-filter>
	    <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/device_filter"/>
	    <!-- Qt6 androiddeployqt only needs the app lib name; the Qt5 Ministro/local-libs tokens are gone. -->
	    <meta-data android:name="android.app.lib_name" android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
	    <!-- "none", not "default": Qt's ExtractStyle runs during QtActivityLoader construction,
	         before the native libraries are loaded, and "default"/"full" make it call into the
	         Qt Android platform plugin, which fails with
	         "UnsatisfiedLinkError: No implementation found for ExtractStyle.extractNativeChunkInfo20".
	         Scopy supplies its own stylesheet, so mimicking the native Android style is not wanted
	         anyway. The working Qt5 Android branch set "none" for the same reason; that fix never
	         reached main, which is why this had to be rediscovered. -->
	    <meta-data android:name="android.app.extract_android_style" android:value="none"/>
	    <!-- Background running: keep false; setting true can crash if the app draws after suspend. -->
	    <meta-data android:name="android.app.background_running" android:value="false"/>
	    <meta-data android:name="android.app.auto_screen_scale_factor" android:value="false"/>
	    <meta-data android:name="android.app.splash_screen_drawable" android:resource="@drawable/splashscreen"/>
	    <meta-data android:name="android.app.splash_screen_drawable_portrait" android:resource="@drawable/splashscreen_port"/>
	    <meta-data android:name="android.app.splash_screen_drawable_landscape" android:resource="@drawable/splashscreen_land"/>
	</activity>
    </application>
</manifest>
